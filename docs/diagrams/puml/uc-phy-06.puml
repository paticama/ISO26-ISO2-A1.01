@startuml uc-phy-06
left to right direction
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FFF4C2
  BorderColor #A67C1A
  ArrowColor #5A4A1E
}
skinparam actor {
  BackgroundColor #FFF4C2
  BorderColor #A67C1A
}
skinparam rectangle {
  BackgroundColor white
  BorderColor #A67C1A
}
skinparam ArrowFontSize 11
skinparam defaultFontName DejaVu Sans

title UC-PHY-06 - Consult Operational Metrics on Orders: use case diagram

actor "Patient User" as PAT
actor "Physician User" as PHY
PHY -up-|> PAT : <<generalizes>>

rectangle "System: SESCAM Radiodiagnostics - module PHY (Physicians)" {
  usecase "**UC-PHY-06**\nConsult Operational Metrics on Orders" as PHY06
}

PHY -- PHY06
@enduml
