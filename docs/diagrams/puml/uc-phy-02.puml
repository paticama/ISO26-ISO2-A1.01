@startuml uc-phy-02
left to right direction
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FFF4C2
  BorderColor #A67C1A
  ArrowColor #5A4A1E
}
skinparam actor {
  BackgroundColor #FFF4C2
  BorderColor #A67C1A
}
skinparam rectangle {
  BackgroundColor white
  BorderColor #A67C1A
}
skinparam ArrowFontSize 11
skinparam defaultFontName DejaVu Sans

title UC-PHY-02 - Order Periodic Follow-up Surveillance Procedure: use case diagram

actor "Patient User" as PAT
actor "Physician User" as PHY
PHY -up-|> PAT : <<generalizes>>

rectangle "System: SESCAM Radiodiagnostics - module PHY (Physicians)" {
  usecase "**UC-PHY-02**\nOrder Periodic Follow-up Surveillance Procedure" as PHY02
  usecase "**UC-PHY-04**\nAuthor, Edit, and Review Diagnostic Reports and Medical Images\n--\nextension points:\nFollowUpRecommendation" as PHY04
  usecase "Verify Patient Safety Constraints\n& Contrast Allergies" as SEC
}
actor "Administrative / Admissions System" as AAD <<system>>

PHY -- PHY02
PHY02 -- AAD

PHY02 ..> SEC : <<include>>\n[before registering surveillance plan]
PHY02 ..> PHY04 : <<extend>>\n(FollowUpRecommendation)\n[optional recommendation in report conclusions]
@enduml
